# Copie ce fichier en « .env » puis remplis la valeur
# (les installateurs « Installer Watchdog » le font pour toi).

# App › Réglages › Paramètres de la maison › Appareils › « Copier le code de connexion »
TM_CODE=COLLE-LE-CODE-ICI

# Un tour toutes les 60 s ; ticket après 3 échecs d'affilée (≈ 3 min)
INTERVAL=60
FAILS=3
TIMEOUT=3

# Fuseau horaire des messages
TZ=Europe/Paris
